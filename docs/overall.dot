digraph G {
  rankdir=TB;
  graph [fontname="Arial", bgcolor="white", pad="0.3"];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  Dataset [label="Governed Evaluation Case / Dataset"];
  Validation [label="Dataset / Oracle Validation"];
  Constraints [label="Constraint Extraction"];
  ConstraintValidation [label="Constraint Validation / Classification", shape=diamond];
  Clarify [label="Deterministic Clarification\nNo retrieval • No Claude call"];
  Filter [label="Structured Product Filtering"];
  Match [label="Hard constraints have\nmatching products?", shape=diamond];
  NoMatch [label="Deterministic No-Product-Match\nNo Claude call • 0 SUT tokens"];
  Retrieval [label="Embedding + FAISS Ranking\nRetrieval-K / Top-K Candidates"];
  ContextK [label="Adaptive Context Selection\nSimilarity >= 0.30"];
  HasContext [label="Context-K > 0?", shape=diamond];
  Context [label="Context Builder"];
  SUT [label="Claude SUT\nShopping Assistant"];
  Abstain [label="Deterministic Abstention\nNo Claude call • 0 SUT tokens"];
  Answer [label="SUT Output"];

  Oracle [label="Oracle Resolution"];
  Py [label="Deterministic Python Assertions"];
  Judge [label="Semantic LLM Judge"];
  Risk [label="Metric + AI Risk Aggregation"];
  Loc [label="Failure Localization"];
  Gate [label="Quality Gate"];
  CI [label="CI/CD Evidence\nPASS / FAIL"];
  Release [label="Release Validation\nGolden + Broad Nightly Evidence"];
  Telemetry [label="Observability\nretrieval • context • generation path • tokens • latency"];

  Dataset -> Validation -> Constraints -> ConstraintValidation;
  ConstraintValidation -> Clarify [label="unresolved"];
  Clarify -> Answer;
  ConstraintValidation -> Filter [label="resolved"];
  Filter -> Match;
  Match -> NoMatch [label="no"];
  NoMatch -> Answer;
  Match -> Retrieval [label="yes"];
  Retrieval -> ContextK -> HasContext;
  HasContext -> Context [label="yes"];
  Context -> SUT -> Answer;
  HasContext -> Abstain [label="no"];
  Abstain -> Answer;

  Answer -> Oracle;
  Retrieval -> Oracle [label="evidence"];
  ContextK -> Oracle [label="evidence"];
  Oracle -> Py [label="deterministic"];
  Oracle -> Judge [label="semantic_llm"];
  Py -> Risk;
  Judge -> Risk;
  Risk -> Loc -> Gate -> CI;
  CI -> Release [label="when release validation runs"];

  Clarify -> Telemetry;
  NoMatch -> Telemetry;
  Retrieval -> Telemetry;
  ContextK -> Telemetry;
  Context -> Telemetry;
  SUT -> Telemetry;
  Abstain -> Telemetry;
  Telemetry -> Risk;
}
