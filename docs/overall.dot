digraph G {
  rankdir=TB;
  graph [fontname="Arial", bgcolor="white", pad="0.3"];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  Assets [label="Governed Test Assets\nStandard Critical • META • Regression • Nightly • Golden • Adversarial"];
  Validation [label="Dataset / Oracle Validation\nwhere applicable"];
  SUT [label="Shopping RAG SUT\nConstraints • Filtering • Retrieval • Context • Generation"];
  Oracle [label="Oracle Resolution"];
  Py [label="Deterministic Python Assertions"];
  Judge [label="Semantic LLM Judge\nVersioned config • non-empty rationale"];
  Risk [label="Metrics / AI Risk Aggregation"];
  Gate [label="Product Quality Gate"];
  Evidence [label="PASS / FAIL + Evidence"];

  PR [label="PR Quality\n10 Standard Critical + 2 Metamorphic Critical"];
  Meta [label="Metamorphic Runner / Gate\nbase + transformed → relation Oracle"];
  B2B [label="Manual Back-to-Back\n10 Standard Critical → Model A + Model B\nquality • regression • latency • tokens"];
  Adv [label="Scheduled / Manual Adversarial\n10-case hostile-input dataset\nPass Rate • Attack Success Rate • category breakdown"];
  Regression [label="Regression\n15 cases • manual-only"];
  Nightly [label="Broad Nightly\n80 cases • manual-only"];
  Release [label="Release Validation\n35 Golden + broad Nightly evidence"];

  JudgeAssets [label="Approved Judge Assets on main\nModel • Prompt v2 • Rubric"];
  JudgeChange [label="Judge Change PR"];
  OldJudge [label="OLD Judge\nPR base / main"];
  NewJudge [label="NEW Judge\nPR head"];
  Calibration [label="8-case Human-Reviewed\nJudge Calibration Dataset"];
  CalibrationGate [label="Judge Calibration Gate\nAgreement • Delta • False PASS"];

  GoldenChange [label="Golden Dataset Change PR"];
  GoldenMetadata [label="Change Reason • Source of Truth"];
  GoldenCheck [label="Golden Governance Check"];

  Assets -> Validation -> SUT -> Oracle;
  Oracle -> Py [label="deterministic"];
  Oracle -> Judge [label="semantic_llm"];
  Py -> Risk;
  Judge -> Risk;
  Risk -> Gate -> Evidence;

  PR -> Validation;
  PR -> Meta;
  Meta -> Evidence;
  B2B -> SUT;
  B2B -> Evidence;
  Adv -> Validation;
  Adv -> SUT;
  Adv -> Evidence;
  Regression -> Validation;
  Nightly -> Validation;
  Release -> Validation;

  JudgeAssets -> Judge;
  JudgeChange -> OldJudge;
  JudgeChange -> NewJudge;
  Calibration -> OldJudge;
  Calibration -> NewJudge;
  OldJudge -> CalibrationGate;
  NewJudge -> CalibrationGate;
  CalibrationGate -> Evidence [label="evaluator evidence"];
  CalibrationGate -> JudgeAssets [label="after approved merge"];

  GoldenChange -> GoldenMetadata -> GoldenCheck -> Evidence;
}
