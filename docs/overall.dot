digraph G {
  rankdir=TB;
  graph [fontname="Arial", bgcolor="white", pad="0.3"];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  Dataset [label="User / Evaluation Dataset"];
  Validation [label="Dataset / Oracle Validation\n(evaluation datasets)"];
  Fixtures [label="Case-scoped Test Fixtures\nonly when declared by evaluation case"];
  Constraints [label="Constraint Extraction"];
  Filter [label="Structured Product Filtering"];
  Match [label="Hard constraints have\nmatching products?", shape=diamond];
  NoMatch [label="Deterministic No-Product-Match\nNo SUT API call • 0 SUT tokens"];
  Cheapest [label="Cheapest / lowest-price\nrequest?", shape=diamond];
  MinPrice [label="Structured Catalogue Min-Price\nDeterministic evidence"];
  Corpus [label="Approved Corpus"];
  Retrieval [label="Embedding + FAISS Ranking\nTop-K Candidates"];
  ContextK [label="Adaptive Context Selection\nSimilarity >= 0.30 + Max Context-K"];
  HasContext [label="Context-K > 0?", shape=diamond];
  Context [label="Context Builder"];
  SUT [label="Claude SUT\nShopping Assistant"];
  Abstain [label="Deterministic No-Context Abstention\nNo SUT API call • 0 SUT tokens"];
  Answer [label="Answer"];

  Py [label="Deterministic Evidence\nRetrieval Routing • Context Selection • Atomic Assertions"];
  Oracle [label="Oracle Resolution"];
  Judge [label="Semantic LLM Judge"];
  Risk [label="AI Risk Reporting + Coverage Matrix"];
  Gate [label="Quality Gate"];
  CI [label="GitHub Actions\nPASS / FAIL"];
  Telemetry [label="Observability\nRetrieval Strategy • Selection • Generation Path • Tokens • Latency"];
  Governance [label="Governed JSON Datasets\nDataset authoritative • Mapper derived"];

  Dataset -> Validation -> Constraints -> Filter;
  Validation -> Fixtures;
  Fixtures -> Corpus [label="evaluation-only augmentation"];
  Filter -> Match;
  Match -> NoMatch [label="no"];
  NoMatch -> Answer;
  Match -> Cheapest [label="yes / constraints"];
  Constraints -> Cheapest [label="no hard constraints"];
  Cheapest -> MinPrice [label="yes"];
  Cheapest -> Corpus [label="no"];
  MinPrice -> ContextK;
  Corpus -> Retrieval -> ContextK;
  ContextK -> HasContext;
  HasContext -> Context [label="yes"];
  Context -> SUT -> Answer;
  HasContext -> Abstain [label="no"];
  Abstain -> Answer;

  Filter -> Py;
  MinPrice -> Py;
  Retrieval -> Py;
  ContextK -> Py;
  Context -> Py;
  Answer -> Oracle;
  Py -> Oracle;
  Oracle -> Judge [label="semantic_llm"];
  Oracle -> Risk [label="deterministic evidence"];
  Judge -> Risk;
  Risk -> Gate -> CI;

  NoMatch -> Telemetry;
  MinPrice -> Telemetry;
  Retrieval -> Telemetry;
  ContextK -> Telemetry;
  Context -> Telemetry;
  SUT -> Telemetry;
  Abstain -> Telemetry;
  Telemetry -> Risk;
  Governance -> Dataset;
}
