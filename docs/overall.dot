digraph G {
  rankdir=TB;
  graph [fontname="Arial", bgcolor="white", pad="0.3"];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  Dataset [label="User / Evaluation Dataset"];
  Constraints [label="Constraint Extraction / Filtering"];
  Embed [label="Embedding\nall-MiniLM-L6-v2"];
  Vector [label="FAISS Vector Store"];
  Retrieval [label="Top-K Retrieval"];
  ContextK [label="Adaptive Context-K"];
  Context [label="Context Builder"];
  SUT [label="Claude SUT\nShopping Assistant"];
  Answer [label="Generated Answer"];

  Py [label="Deterministic Python Metrics\nRetrieval Hit • Constraint Match • Precision@K"];
  Judge [label="Claude Judge\nCorrectness • Groundedness • Hallucination\nConstraint Adherence • Context Coverage/Sufficiency"];
  Risk [label="AI Risk Reporting + Coverage Matrix"];
  Gate [label="Quality Gate"];
  CI [label="GitHub Actions\nPR PASS / FAIL"];
  Telemetry [label="Observability\nRetrieval • Context • LLM • Latency • Tokens"];
  Governance [label="Dataset Governance\nExcel review layer → JSON execution"];

  Dataset -> Constraints -> Embed -> Vector -> Retrieval -> ContextK -> Context -> SUT -> Answer;
  Retrieval -> Py;
  ContextK -> Judge [label="retrieved evidence"];
  Answer -> Judge;
  Py -> Risk;
  Judge -> Risk;
  Risk -> Gate -> CI;
  Retrieval -> Telemetry;
  Context -> Telemetry;
  SUT -> Telemetry;
  Telemetry -> Risk;
  Governance -> Dataset;
}
