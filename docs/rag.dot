digraph G {
  rankdir=LR;
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  Q [label="Query"];
  C [label="Constraint Extraction"];
  V [label="Constraint Validation / Classification", shape=diamond];
  CL [label="Deterministic Clarification\nNo retrieval • No Claude call"];
  F [label="Structured Product Filtering"];
  MATCH [label="Any products match\nall hard constraints?", shape=diamond];
  NM [label="Deterministic No-Product-Match\nNo Claude call • 0 SUT tokens"];
  E [label="Embedding + FAISS\nSemantic Ranking"];
  R [label="Retrieval-K / Top-K Candidates\ndefault max K=5"];
  K [label="Adaptive Context Selection\nscore >= 0.30 • max Context-K"];
  HAS [label="Context-K > 0?", shape=diamond];
  X [label="Context Builder"];
  S [label="Claude SUT"];
  N [label="Deterministic Abstention\nNo Claude call • 0 SUT tokens"];
  A [label="SUT Output"];
  M [label="Retrieval / Constraint Metrics"];
  T [label="Telemetry\nretrieval candidates • selected/dropped\ncontext_k • generation path • tokens • latency"];

  Q -> C -> V;
  V -> CL [label="unresolved"];
  CL -> A;
  V -> F [label="resolved"];
  F -> MATCH;
  MATCH -> NM [label="no"];
  NM -> A;
  MATCH -> E [label="yes"];
  E -> R -> K -> HAS;
  HAS -> X [label="yes"];
  X -> S -> A;
  HAS -> N [label="no"];
  N -> A;

  F -> M;
  R -> M;
  CL -> T;
  NM -> T;
  R -> T;
  K -> T;
  X -> T;
  S -> T;
  N -> T;
}
