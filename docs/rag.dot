digraph G {
  rankdir=LR;
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  Q [label="Query"];
  C [label="Constraint Extraction"];
  D [label="Supported constraints\nand product match?", shape=diamond];
  F [label="Structured Product Filtering"];
  ALL [label="Full Corpus"];
  E [label="Embedding + FAISS\nSemantic Ranking"];
  R [label="Top-K Retrieval Candidates\ndefault max 5"];
  K [label="Adaptive Context Selection\nscore >= threshold • max Context-K"];
  X [label="Context Builder"];
  S [label="Claude SUT"];
  A [label="Answer"];
  M [label="Retrieval Metrics\nHit • Match • Precision@K"];
  T [label="Telemetry\nIDs • ranks • scores • selected context_k • tokens • latency"];

  Q -> C -> D;
  D -> F [label="yes"];
  D -> ALL [label="no / no match"];
  F -> E;
  ALL -> E;
  E -> R -> K -> X -> S -> A;
  R -> M;
  R -> T;
  K -> T;
  X -> T;
  S -> T;
}
