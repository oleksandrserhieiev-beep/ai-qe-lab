digraph G {
  rankdir=LR;
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  Q [label="Query"];
  C [label="Constraint Extraction"];
  D [label="Supported hard\nproduct constraints?", shape=diamond];
  F [label="Structured Product Filtering"];
  MATCH [label="Any products match\nall hard constraints?", shape=diamond];
  NM [label="Deterministic no-product-match\nNo Claude call • 0 SUT tokens"];
  CHEAP [label="Cheapest / lowest-price\nrequest?", shape=diamond];
  MIN [label="Structured catalogue min-price\nDeterministic ranked evidence"];
  ALL [label="Approved Full Corpus\n+ case-scoped test fixtures when declared"];
  E [label="Embedding + FAISS\nSemantic Ranking"];
  R [label="Retrieval Candidates\ndefault max K=5"];
  K [label="Adaptive Context Selection\nscore >= 0.30 • max Context-K"];
  HAS [label="Context-K > 0?", shape=diamond];
  X [label="Context Builder"];
  S [label="Claude SUT"];
  N [label="Deterministic no-context abstention\nNo Claude call • 0 SUT tokens"];
  A [label="Answer"];
  M [label="Retrieval Metrics\nHit • Match • Precision@K"];
  T [label="Telemetry\nretrieval strategy • candidates • selected/dropped\ncontext_k • generation path • tokens • latency"];

  Q -> C -> D;
  D -> F [label="yes"];
  F -> MATCH;
  MATCH -> NM [label="no"];
  NM -> A;
  MATCH -> CHEAP [label="yes"];
  D -> CHEAP [label="no"];
  CHEAP -> MIN [label="yes"];
  CHEAP -> ALL [label="no"];
  MIN -> R;
  ALL -> E -> R;
  R -> K -> HAS;
  HAS -> X [label="yes"];
  X -> S -> A;
  HAS -> N [label="no"];
  N -> A;
  R -> M;
  F -> M;
  NM -> T;
  MIN -> T;
  R -> T;
  K -> T;
  X -> T;
  S -> T;
  N -> T;
}
