LLM_PROVIDER=anthropic
LLM_API_KEY=replace_me
SUT_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-5
# Optional cheaper judge for lower-risk cases. Leave empty to use JUDGE_MODEL for all cases.
JUDGE_MODEL_LIGHT=
# Model used by the Agentic QE Requirements Review Agent. Falls back to SUT_MODEL if empty.
REQUIREMENTS_REVIEW_MODEL=claude-sonnet-5

JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=replace_me
JIRA_API_TOKEN=replace_me
JIRA_PROJECT_KEY=AIQE

# RAG retrieval and adaptive context selection.
RAG_TOP_K=5
RAG_MIN_CONTEXT_K=2
RAG_MAX_CONTEXT_K=5
RAG_MIN_SIMILARITY=0.30

APP_ENV=local

# Optional price overrides in USD per 1M tokens.
PRICE_CLAUDE_SONNET_5_INPUT_PER_M=2
PRICE_CLAUDE_SONNET_5_OUTPUT_PER_M=10
PRICE_CLAUDE_OPUS_5_INPUT_PER_M=5
PRICE_CLAUDE_OPUS_5_OUTPUT_PER_M=25
